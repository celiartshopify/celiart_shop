{{ 'celiart-home.css' | asset_url | stylesheet_tag }}
<section class="celiart-section ca-manga"><div class="celiart-wrap ca-manga__grid"><div class="ca-manga__copy"><span class="celiart-kicker">{{ section.settings.kicker }}</span><h2 class="celiart-serif">{{ section.settings.heading }}</h2><a class="celiart-btn celiart-btn--rose" href="{{ section.settings.link | default: '#' }}">{{ section.settings.button }} ✦</a></div><div class="ca-manga__media">{% render 'celiart-image', image: section.settings.image, alt: section.settings.heading, class: 'ca-manga__image', sizes: '(max-width:989px) 100vw, 70vw' %}</div></div></section>
{% schema %}{"name":"CeliArt — Bannière Manga","settings":[{"type":"text","id":"kicker","label":"Sur-titre","default":"Inspiration Manga"},{"type":"text","id":"heading","label":"Titre","default":"Votre univers préféré, brodé."},{"type":"text","id":"button","label":"Bouton","default":"Découvrir les designs"},{"type":"url","id":"link","label":"Lien"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"CeliArt — Bannière Manga"}]}{% endschema %}
