{{ 'celiart-collection.css' | asset_url | stylesheet_tag }}
<section class="cc-newsletter">
  <div class="cc-shell">
    <div class="cc-newsletter__panel">
      <div class="cc-newsletter__icon" aria-hidden="true">
        <svg viewBox="0 0 96 96"><path d="M13 27h70v52H13Z"/><path d="m13 29 35 27 35-27"/><path d="M31 18c5-7 14-5 17 2 3-7 12-9 17-2 7 10-17 25-17 25S24 28 31 18Z"/><path d="m13 78 27-26M83 78 56 52"/></svg>
      </div>
      <div class="cc-newsletter__copy">
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.text | escape }}</p>
      </div>
      <div class="cc-newsletter__form-wrap">
        {% form 'customer', class: 'cc-newsletter__customer-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="cc-newsletter__form">
            <label class="cc-visually-hidden" for="NewsletterEmail-{{ section.id }}">Adresse e-mail</label>
            <input class="cc-newsletter__input" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Votre adresse e-mail" autocorrect="off" autocapitalize="off" autocomplete="email" required>
            <button class="cc-newsletter__button" type="submit">{{ section.settings.button | escape }} <span>♥</span></button>
          </div>
          <label class="cc-newsletter__consent"><input type="checkbox" required> J’accepte de recevoir la newsletter</label>
          {% if form.posted_successfully? %}<p class="cc-newsletter__message">Merci, votre inscription est confirmée.</p>{% endif %}
          {% if form.errors %}<p class="cc-newsletter__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CeliArt newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Rejoignez notre univers" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Recevez nos nouveautés, inspirations et offres exclusives." },
    { "type": "text", "id": "button", "label": "Bouton", "default": "S’inscrire" }
  ],
  "presets": [{ "name": "CeliArt newsletter" }]
}
{% endschema %}
