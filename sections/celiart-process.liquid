{{ 'celiart-home.css' | asset_url | stylesheet_tag }}
<section class="celiart-section ca-process"><div class="celiart-wrap"><div class="ca-process__panel">
<h2 class="celiart-script ca-process__title">{{ section.settings.heading }}</h2><div class="ca-process__grid">
{% for block in section.blocks %}<div class="ca-step" {{ block.shopify_attributes }}><div class="ca-step__num">{{ forloop.index }}</div><div class="ca-step__icon">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endfor %}
</div></div></div></section>
{% schema %}{"name":"CeliArt — Étapes","settings":[{"type":"text","id":"heading","label":"Titre","default":"Comment ça marche ?"}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"text","id":"icon","label":"Icône/emoji","default":"✎"},{"type":"text","id":"title","label":"Titre","default":"Choisissez"},{"type":"textarea","id":"text","label":"Texte","default":"Votre produit préféré"}]}],"max_blocks":4,"presets":[{"name":"CeliArt — Étapes","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}{% endschema %}
